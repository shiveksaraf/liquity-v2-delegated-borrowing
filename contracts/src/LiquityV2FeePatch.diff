+    function _applyBatchJoinUpfrontFee(
+        uint256 _troveEntireColl,
+        uint256 _troveEntireDebt,
+        uint256 _oldAnnualInterestRate,
+        uint256 _newBatchAnnualInterestRate,
+        uint256 _lastInterestRateAdjTime,
+        TroveChange memory _troveChange,
+        uint256 _maxUpfrontFee
+    ) internal returns (uint256) {
+        uint256 price = _requireOraclesLive();
+
+        uint256 avgInterestRate = activePool.getNewApproxAvgInterestRateFromTroveChange(_troveChange);
+        uint256 baseFee = _calcUpfrontFee(_troveEntireDebt, avgInterestRate);
+        uint256 fee = baseFee;
+        if (
+            _newBatchAnnualInterestRate < _oldAnnualInterestRate
+                && block.timestamp < _lastInterestRateAdjTime + INTEREST_RATE_ADJ_COOLDOWN
+        ) {
+            uint256 cutFee = _calcDesignAStarFee(
+                _troveEntireDebt,
+                _oldAnnualInterestRate,
+                _newBatchAnnualInterestRate,
+                block.timestamp - _lastInterestRateAdjTime
+            );
+            if (cutFee > fee) fee = cutFee;
+        }
+        _troveChange.upfrontFee = fee;
+        _requireUserAcceptsUpfrontFee(_troveChange.upfrontFee, _maxUpfrontFee);
+
+        _troveEntireDebt += _troveChange.upfrontFee;
+
+        uint256 newICR = LiquityMath._computeCR(_troveEntireColl, _troveEntireDebt, price);
+        _requireICRisAboveMCRPlusBCR(newICR);
+
+        uint256 newTCR = _getNewTCRFromTroveChange(_troveChange, price);
+        _requireNewTCRisAboveCCR(newTCR);
+
+        return _troveEntireDebt;
     }
 
+    function _applyPrematureRateAdjFee(
+        uint256 _troveEntireColl,
+        uint256 _troveEntireDebt,
+        uint256 _oldAnnualInterestRate,
+        uint256 _newAnnualInterestRate,
+        uint256 _elapsed,
+        TroveChange memory _troveChange,
+        uint256 _maxUpfrontFee,
+        bool _isTroveInBatch
+    ) internal returns (uint256) {
+        uint256 price = _requireOraclesLive();
+
+        _troveChange.upfrontFee =
+            _calcDesignAStarFee(_troveEntireDebt, _oldAnnualInterestRate, _newAnnualInterestRate, _elapsed);
+        _requireUserAcceptsUpfrontFee(_troveChange.upfrontFee, _maxUpfrontFee);
+
+        _troveEntireDebt += _troveChange.upfrontFee;
+
+        uint256 newICR = LiquityMath._computeCR(_troveEntireColl, _troveEntireDebt, price);
+        if (_isTroveInBatch) {
+            _requireICRisAboveMCRPlusBCR(newICR);
+        } else {
+            _requireICRisAboveMCR(newICR);
+        }
+
+        uint256 newTCR = _getNewTCRFromTroveChange(_troveChange, price);
+        _requireNewTCRisAboveCCR(newTCR);
+
+        return _troveEntireDebt;
+    }
+
+    function _calcDesignAStarFee(
+        uint256 _debt,
+        uint256 _oldRate,
+        uint256 _newRate,
+        uint256 _elapsed
+    ) internal pure returns (uint256) {
+        if (_newRate > _oldRate) {
+            return _calcInterest(_debt * (_newRate - _oldRate), UPFRONT_INTEREST_PERIOD);
+        }
+        return _calcInterest(_debt * (_oldRate - _newRate), UPFRONT_INTEREST_PERIOD - _elapsed);
+    }
